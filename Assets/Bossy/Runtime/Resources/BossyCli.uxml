<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="cli-root" class="bossy-cli">
        <ui:ListView name="output-list" class="bossy-cli__output"/>
        <ui:VisualElement name="input-row" class="bossy-cli__input-row">
            <ui:VisualElement name="auto-complete" class="bossy-cli__suggestions">
                <ui:VisualElement name="completion-status" class="bossy-cli__status"/>
                <ui:ListView name="completion-list" class="bossy-cli__suggestion-list"/>
            </ui:VisualElement>
            <ui:Label name="prompt-label" text="&gt;" class="bossy-cli__prompt"/>
            <ui:TextField name="input-field" class="bossy-cli__input"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
