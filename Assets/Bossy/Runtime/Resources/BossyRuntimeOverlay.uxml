<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="overlay-root" picking-mode="Ignore" class="bossy-overlay__layer">
        <ui:VisualElement name="console-layer" picking-mode="Ignore" class="bossy-overlay__layer">
            <ui:VisualElement name="console-panel" class="bossy-runtime-console bossy-runtime-console--hidden" style="display: none;"/>
        </ui:VisualElement>
        <ui:VisualElement name="window-layer" picking-mode="Ignore" class="bossy-overlay__layer"/>
    </ui:VisualElement>
</ui:UXML>
