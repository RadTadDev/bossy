<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="window" style="position: absolute; left: 40px; top: 40px; width: 250px; height: 350px; background-color: rgb(121, 187, 226);">
        <ui:VisualElement name="title-handle" style="position: absolute; top: 0; left: 0; right: 0; height: 25px;">
            <ui:Label name="title" text="Bossy" style="margin-left: 4px; margin-top: 4px; color: rgb(20, 20, 20);"/>
        </ui:VisualElement>
        <ui:Button name="button-close" text="X" style="position: absolute; top: 0; right: 0; width: 15px; height: 15px; font-size: 17px;"/>
        <ui:VisualElement name="content-area" style="position: absolute; top: 25px; left: 0; right: 0; bottom: 0; background-color: rgb(55, 55, 55);"/>
        <ui:VisualElement name="drag-handle" style="position: absolute; right: 0; bottom: 0; width: 10px; height: 10px; background-color: rgb(229, 229, 229);"/>
    </ui:VisualElement>
</ui:UXML>
