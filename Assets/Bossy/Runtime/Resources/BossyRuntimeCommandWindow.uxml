<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="window" class="bossy-window bossy-window--entering">
        <ui:VisualElement name="title-handle" class="bossy-window__title-bar">
            <ui:Label name="title" text="Bossy" class="bossy-window__title"/>
            <ui:Button name="button-close" text="×" tooltip="Close and end the command" class="bossy-window__close"/>
        </ui:VisualElement>
        <ui:VisualElement name="content-area" class="bossy-window__content"/>
        <ui:VisualElement name="drag-handle" class="bossy-window__resize-handle"/>
    </ui:VisualElement>
</ui:UXML>
