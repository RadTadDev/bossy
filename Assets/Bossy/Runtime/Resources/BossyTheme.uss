/*
 * Bossy theme. Every Bossy window and the runtime overlay add this sheet and the .bossy-root class.
 * Command views can use the variables below to match the console.
 * The status colors are mirrored in Format so rich text output matches; keep them in sync.
 */

.bossy-root {
    --bossy-bg: #1f1e1d;
    --bossy-surface: #2a2927;
    --bossy-surface-raised: #353430;
    --bossy-border: #403f3a;
    --bossy-text: #e8e6dc;
    --bossy-text-muted: #a3a197;
    --bossy-text-faint: #6f6d66;
    --bossy-accent: #d97757;
    --bossy-accent-soft: rgba(217, 119, 87, 0.2);
    --bossy-blue: #8fb8de;
    --bossy-green: #9fca8b;
    --bossy-yellow: #e3c47e;
    --bossy-red: #e58a84;
    --bossy-font-size: 14px;
    --bossy-radius: 8px;

    flex-grow: 1;
    background-color: var(--bossy-bg);
    color: var(--bossy-text);
    font-size: var(--bossy-font-size);
}

/* ── Command line ─────────────────────────────────────────────── */

.bossy-cli {
    flex-grow: 1;
    padding: 8px 10px 10px 12px;
}

.bossy-cli__output {
    flex-grow: 1;
    background-color: transparent;
}

.bossy-cli__line {
    color: var(--bossy-text);
    /* Keeps runs of spaces so aligned output stays aligned, and still wraps long lines */
    white-space: pre-wrap;
    padding: 1px 0;
}

.bossy-cli__input-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-top: 6px;
    padding: 6px 10px;
    background-color: var(--bossy-surface);
    border-width: 1px;
    border-color: var(--bossy-border);
    border-radius: var(--bossy-radius);
    transition-property: border-color;
    transition-duration: 120ms;
}

.bossy-cli__input-row--focused {
    border-color: var(--bossy-accent);
}

.bossy-cli__prompt {
    margin: 0 8px 0 0;
    padding: 0;
    color: var(--bossy-accent);
    -unity-font-style: bold;
}

.bossy-cli__input {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    min-height: 0;
    --unity-cursor-color: var(--bossy-accent);
    --unity-selection-color: var(--bossy-accent-soft);
}

.bossy-cli__input > #unity-text-input {
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: transparent;
    color: var(--bossy-text);
}

.bossy-cli__input:disabled {
    opacity: 0.4;
}

/* Suggestions float just above the input row */
.bossy-cli__suggestions {
    position: absolute;
    left: 0;
    bottom: 100%;
    min-width: 240px;
    max-width: 100%;
    margin-bottom: 6px;
    padding: 4px;
    background-color: var(--bossy-surface-raised);
    border-width: 1px;
    border-color: var(--bossy-border);
    border-radius: var(--bossy-radius);
    opacity: 0;
    visibility: hidden;
    transition-property: opacity;
    transition-duration: 100ms;
}

.bossy-cli__suggestions--visible {
    opacity: 1;
    visibility: visible;
}

.bossy-cli__suggestion {
    margin: 0;
    padding: 3px 8px;
    border-radius: 4px;
    color: var(--bossy-text);
}

.bossy-cli__suggestion--selected {
    background-color: var(--bossy-accent-soft);
}

.bossy-cli__suggestion--hint {
    color: var(--bossy-blue);
}

.bossy-cli__suggestion--error {
    color: var(--bossy-red);
}

/* Thin scrollbar without arrow buttons */
.bossy-cli__output .unity-scroller--vertical {
    width: 8px;
}

.bossy-cli__output .unity-scroller__low-button,
.bossy-cli__output .unity-scroller__high-button {
    display: none;
}

.bossy-cli__output .unity-scroller__slider {
    margin: 0;
}

.bossy-cli__output .unity-base-slider__tracker {
    background-color: transparent;
    border-width: 0;
}

.bossy-cli__output .unity-base-slider__dragger {
    background-color: var(--bossy-border);
    border-width: 0;
    border-radius: 4px;
}

/* ── Command views ────────────────────────────────────────────── */

.bossy-command-view {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--bossy-bg);
    transition-property: opacity, translate;
    transition-duration: 140ms, 140ms;
    transition-timing-function: ease-out-cubic, ease-out-cubic;
}

.bossy-command-view--entering {
    opacity: 0;
    translate: 0 8px;
}

/* ── Runtime overlay ──────────────────────────────────────────── */

/* The overlay covers the screen, so only its panels are drawn */
.bossy-root.bossy-overlay {
    background-color: transparent;
}

.bossy-overlay__layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* The runtime console slides down from the top of the screen */
.bossy-runtime-console {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    height: 45%;
    min-height: 260px;
    background-color: rgba(31, 30, 29, 0.97);
    border-bottom-width: 1px;
    border-color: var(--bossy-border);
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    transition-property: translate, opacity;
    transition-duration: 160ms, 160ms;
    transition-timing-function: ease-out-cubic, ease-out-cubic;
}

.bossy-runtime-console--hidden {
    translate: 0 -100%;
    opacity: 0;
}

/* ── Runtime command windows ──────────────────────────────────── */

.bossy-window {
    position: absolute;
    width: 320px;
    height: 360px;
    background-color: var(--bossy-surface);
    border-width: 1px;
    border-color: var(--bossy-border);
    border-radius: 10px;
    overflow: hidden;
    transition-property: opacity, scale;
    transition-duration: 140ms, 140ms;
    transition-timing-function: ease-out-cubic, ease-out-cubic;
}

.bossy-window--entering {
    opacity: 0;
    scale: 0.96 0.96;
}

.bossy-window__title-bar {
    flex-direction: row;
    align-items: center;
    height: 28px;
    padding: 0 4px 0 10px;
    background-color: var(--bossy-surface);
    border-bottom-width: 1px;
    border-color: var(--bossy-border);
}

.bossy-window__title {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    color: var(--bossy-text-muted);
    font-size: 12px;
    -unity-text-overflow-position: end;
    text-overflow: ellipsis;
    overflow: hidden;
}

.bossy-window__close {
    width: 22px;
    height: 22px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 4px;
    background-color: transparent;
    color: var(--bossy-text-muted);
    font-size: 14px;
}

.bossy-window__close:hover {
    background-color: var(--bossy-surface-raised);
    color: var(--bossy-red);
}

.bossy-window__content {
    flex-grow: 1;
}

.bossy-window__resize-handle {
    position: absolute;
    right: 2px;
    bottom: 2px;
    width: 12px;
    height: 12px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-color: var(--bossy-text-faint);
    border-bottom-right-radius: 3px;
}
